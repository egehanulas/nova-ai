{
  "name": "nova-ai",
  "version": "0.2.0-alpha.7",
  "description": "NOVA AI Türkçe sohbet sitesi",
  "main": "server.js",
  "scripts": {
    "start": "npm run check && node server.js",
    "ingest:knowledge": "node scripts/ingest-knowledge.js",
    "check": "node --check server.js && node --check public/app.js && node --check public/voice.js && node --check public/desktop-voice.js && node --check scripts/ingest-knowledge.js && node --check scripts/test-embeddings.js && npm run test:web-research && npm run test:release-metadata",
    "test:embeddings": "node scripts/test-embeddings.js",
    "test:web-research": "node --test web-research.test.js",
    "test:release-metadata": "node --test release-metadata.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.76.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "@huggingface/transformers": "^4.3.2"
  },
  "engines": {
    "node": ">=20"
  }
}
