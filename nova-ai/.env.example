# Sunucu ayarları — gerçek anahtarları GitHub'a yükleme.
PORT=3000
APP_URL=http://localhost:3000
REQUEST_TIMEOUT_MS=60000

# En az bir model sağlayıcısı gereklidir.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# İsteğe bağlı yedek sağlayıcılar
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# İsteğe bağlı ElevenLabs TTS
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Supabase sunucu tarafı oturum doğrulaması
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Yalnızca GitHub Actions toplu veri aktarımında kullanılır; asla istemciye koyma.
SUPABASE_SERVICE_ROLE_KEY=

# Görsel üretim modeli (Gemini API erişimi gerekir)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
