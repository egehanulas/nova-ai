# Sunucu
PORT=3000
APP_URL=http://localhost:3000
REQUEST_TIMEOUT_MS=100000
PROVIDER_TIMEOUT_MS=30000

# En az bir sohbet sağlayıcısı gereklidir
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# İsteğe bağlı yapılandırılmış futbol verisi
API_FOOTBALL_KEY=

# Supabase — oturum, sohbetler ve NOVA hafızası
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Yalnızca seçilmiş Unreal dokümanlarını içe aktarmak için; tarayıcıya koyma
SUPABASE_SERVICE_ROLE_KEY=

# İsteğe bağlı tarayıcı dışı TTS endpoint'i
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Görsel üretimi: Pollinations varsa önceliklidir, yoksa Cloudflare kullanılır
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=flux
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-dev
